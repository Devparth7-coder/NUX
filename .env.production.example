# ─────────────────────────────────────────────────────────────
# NEXUS — production environment (Vercel)
# Copy these into Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Database. Neon / Supabase / Vercel Postgres — pooled connection string.
NEXUS_DB_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/nexus?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection, required by Prisma migrations.
DIRECT_URL="postgresql://user:password@host.neon.tech/nexus?sslmode=require"

# Session signing. Generate: openssl rand -hex 32
NEXUS_SESSION_SECRET=""

# AI provider. Leave as "mock" to run the honest DEMO MODE on Vercel.
NEXUS_AI_PROVIDER="openai"
NEXUS_AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
# Embeddings: "openai" uses text-embedding-3-small; "local" keeps the offline
# 384-d hashing model (no API cost, works anywhere).
NEXUS_EMBED_PROVIDER="openai"
NEXUS_EMBED_MODEL="text-embedding-3-small"

# Object storage. Vercel's filesystem is ephemeral — uploaded documents must
# go to S3-compatible storage (AWS S3, Cloudflare R2, Supabase Storage).
NEXUS_STORAGE_DRIVER="s3"
NEXUS_S3_BUCKET=""
NEXUS_S3_REGION="auto"
NEXUS_S3_ACCESS_KEY_ID=""
NEXUS_S3_SECRET_ACCESS_KEY=""
NEXUS_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"

# Job driver. "inline" runs work inside the request (fine for the demo);
# "queue" persists jobs for the scheduled worker to drain.
NEXUS_JOB_DRIVER="inline"

# Required to authenticate the scheduled worker (Vercel Cron) and for
# NEXUS_JOB_DRIVER=queue deployments.
CRON_SECRET=""
