// ─────────────────────────────────────────────────────────────────────────────
// NEXUS — PRODUCTION data model (PostgreSQL + pgvector)
//
// Identical models to schema.prisma, with:
//   • pgvector `vector(384)` embeddings and HNSW indexes
//   • full-text tsvector support columns
// Activate with:
//   NEXUS_DB_PROVIDER=postgresql DATABASE_URL=postgresql://... npx prisma db push --schema prisma/schema.postgres.prisma
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Identity & tenancy ───────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  role         String   @default("OWNER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  sessions      Session[]
  projects      Project[]        @relation("ProjectOwner")
  tasks         Task[]           @relation("TaskCreator")
  documents     Document[]
  conversations Conversation[]
  memories      Memory[]
  intents       Intent[]
  approvals     Approval[]       @relation("ApprovalDecider")
  notifications Notification[]
  activities    Activity[]
  artifacts     Artifact[]
  agentRuns     AgentRun[]       @relation("RunTrigger")
  workflows     Workflow[]
  integrations  Integration[]
  settings      Setting[]

  @@index([email])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  activities  Activity[]
  documents   Document[]
  tasks       Task[]
  memories    Memory[]
  agents      Agent[]

  @@index([slug])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id           String    @id @default(cuid())
  workspaceId  String
  ownerId      String
  name         String
  slug         String
  description  String?
  summary      String?
  objective    String?
  status       String    @default("ACTIVE") // PLANNING | ACTIVE | AT_RISK | BLOCKED | COMPLETED | ARCHIVED
  health       String    @default("HEALTHY") // HEALTHY | AT_RISK | BLOCKED | COMPLETED
  healthScore  Int       @default(80)
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  progress     Int       @default(0)
  color        String    @default("#3B82F6")
  deadline     DateTime?
  tags         String    @default("[]") // JSON string[]
  metadata     String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User           @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  tasks         Task[]
  documents     Document[]
  knowledge     KnowledgeItem[]
  milestones    Milestone[]
  memories      Memory[]
  conversations Conversation[]
  intents       Intent[]
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  activities    Activity[]
  workflows     Workflow[]
  approvals     Approval[]
  notifications Notification[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([ownerId])
  @@index([deadline])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, order])
}

// ── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String?
  milestoneId    String?
  createdById    String
  createdByAgent String? // agent id when NEXUS created it
  title          String
  description    String?
  status         String    @default("TODO") // TODO | IN_PROGRESS | BLOCKED | DONE
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  deadline       DateTime?
  assignee       String?
  source         String    @default("USER") // USER | AGENT | WORKFLOW
  sourceRunId    String?
  tags           String    @default("[]")
  order          Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy    User       @relation("TaskCreator", fields: [createdById], references: [id])
  dependencies TaskDependency[] @relation("TaskDependsOn")
  dependents   TaskDependency[] @relation("TaskRequiredBy")

  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([deadline])
  @@index([createdById])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  type        String   @default("BLOCKS")
  createdAt   DateTime @default(now())

  task      Task @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskRequiredBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

// ── Documents & retrieval ────────────────────────────────────────────────────

model Document {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String?
  uploadedById   String
  title          String
  description    String?
  mimeType       String
  size           Int       @default(0)
  storageKey     String
  status         String    @default("PENDING") // PENDING | EXTRACTING | CHUNKING | EMBEDDING | INDEXED | FAILED
  error          String?
  pageCount      Int       @default(0)
  wordCount      Int       @default(0)
  chunkCount     Int       @default(0)
  extractedText  String?   @default("")
  summary        String?
  entities       String    @default("[]") // JSON string[]
  metadata       String    @default("{}")
  ingestedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy User            @relation(fields: [uploadedById], references: [id])
  chunks     DocumentChunk[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([uploadedById])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  page       Int      @default(1)
  section    String?
  position   Int      @default(0)
  tokenCount Int      @default(0)
  embedding  Unsupported("vector(384)")?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
}

// ── Knowledge graph ──────────────────────────────────────────────────────────

model KnowledgeItem {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  type        String // PROJECT | PERSON | DOCUMENT | TASK | CONCEPT | DECISION | TECHNOLOGY | ORGANIZATION
  title       String
  content     String?
  summary     String?
  confidence  Float    @default(1.0)
  source      String   @default("USER") // USER | DOCUMENT | AGENT | INTEGRATION
  sourceId    String?
  embedding   Unsupported("vector(384)")?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fromRelations KnowledgeRelation[] @relation("RelationFrom")
  toRelations   KnowledgeRelation[] @relation("RelationTo")

  @@index([workspaceId, type])
  @@index([projectId])
}

model KnowledgeRelation {
  id         String   @id @default(cuid())
  fromId     String
  toId       String
  type       String // RELATED_TO | DEPENDS_ON | MENTIONS | CREATED_FROM | BLOCKS | DECIDED_BY | PART_OF | SIMILAR_TO
  weight     Float    @default(1.0)
  confidence Float    @default(1.0)
  source     String   @default("USER")
  createdAt  DateTime @default(now())

  from KnowledgeItem @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   KnowledgeItem @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([toId])
}

// ── Memory ───────────────────────────────────────────────────────────────────

model Memory {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  projectId      String?
  type           String // SHORT_TERM | PROJECT | LONG_TERM | EXPLICIT | EPISODIC
  content        String
  source         String    @default("USER") // USER | AGENT | SYSTEM | DOCUMENT
  sourceRunId    String?
  confidence     Float     @default(1.0)
  importance     Int       @default(50) // 0-100
  scope          String    @default("WORKSPACE") // SESSION | PROJECT | WORKSPACE | USER
  enabled        Boolean   @default(true)
  pinned         Boolean   @default(false)
  tags           String    @default("[]")
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
  @@index([userId, enabled])
  @@index([projectId])
  @@index([importance])
}

// ── Conversation ─────────────────────────────────────────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String
  projectId   String?
  title       String   @default("New conversation")
  summary     String?
  archived    Boolean  @default(false)
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]
  intents   Intent[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // USER | ASSISTANT | SYSTEM
  content        String
  intentId       String?
  runId          String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Intent → Execution pipeline ──────────────────────────────────────────────

model Intent {
  id                   String   @id @default(cuid())
  workspaceId          String?
  userId               String
  projectId            String?
  conversationId       String?
  rawInput             String
  objective            String
  desiredOutcome       String
  entities             String   @default("[]") // JSON
  constraints          String   @default("[]")
  deadline             DateTime?
  deadlineText         String?
  projectContext       String?
  requiredCapabilities String   @default("[]")
  riskLevel            String   @default("LOW") // LOW | MEDIUM | HIGH
  permissionsRequired  String   @default("[]")
  confidence           Float    @default(0.0)
  status               String   @default("RECEIVED") // RECEIVED | UNDERSTOOD | PLANNING | EXECUTING | WAITING_APPROVAL | COMPLETED | FAILED | CANCELLED
  mode                 String   @default("REAL") // REAL | DEMO
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  runs            AgentRun[]
  artifacts       Artifact[]
  approvals       Approval[]
  activities      Activity[]
  contextItems    ContextItem[]
  workflowRuns    WorkflowRun[]

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([status])
}

/// Provenance record: every item the Context Engine selected, and why.
model ContextItem {
  id           String   @id @default(cuid())
  intentId     String
  sourceType   String // PROJECT | DOCUMENT | DOCUMENT_CHUNK | TASK | KNOWLEDGE | MEMORY | CONVERSATION | ACTIVITY | INTEGRATION | PREFERENCE
  sourceId     String
  title        String
  snippet      String
  semantic     Float    @default(0)
  keyword      Float    @default(0)
  projectScore Float    @default(0)
  recency      Float    @default(0)
  entityScore  Float    @default(0)
  relevance    Float    @default(0)
  rationale    String   @default("")
  createdAt    DateTime @default(now())

  intent Intent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId, relevance])
}

model Agent {
  id              String   @id @default(cuid())
  workspaceId     String?
  key             String   @unique
  name            String
  description     String
  category        String // PLANNING | RESEARCH | EXECUTION | KNOWLEDGE | REVIEW | CREATIVE | ANALYSIS
  systemPrompt    String
  capabilities    String   @default("[]")
  allowedTools    String   @default("[]")
  permissionLevel String   @default("WRITE") // READ | WRITE | EXTERNAL_ACTION | HIGH_IMPACT
  model           String?
  temperature     Float    @default(0.2)
  maxTokens       Int      @default(2048)
  status          String   @default("IDLE") // IDLE | RUNNING | PAUSED | DISABLED | ERROR
  enabled         Boolean  @default(true)
  isSystem        Boolean  @default(true)
  totalRuns       Int      @default(0)
  successRuns     Int      @default(0)
  failedRuns      Int      @default(0)
  totalLatencyMs  Int      @default(0)
  totalTokens     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AgentRun[]

  @@index([category])
}

model AgentRun {
  id           String    @id @default(cuid())
  intentId     String
  agentId      String
  parentRunId  String?
  triggeredById String?
  workspaceId  String?
  projectId    String?
  status       String    @default("QUEUED") // QUEUED | PLANNING | RUNNING | WAITING_APPROVAL | COMPLETED | FAILED | CANCELLED
  stage        String?   // node id in the execution graph
  input        String    @default("{}")
  context      String    @default("[]")
  outputs      String    @default("{}")
  error        String?
  errorStep    String?
  tokens       Int       @default(0)
  cost         Float     @default(0)
  mode         String    @default("REAL") // REAL | DEMO
  attempt      Int       @default(1)
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  intent       Intent          @relation(fields: [intentId], references: [id], onDelete: Cascade)
  agent        Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parent       AgentRun?       @relation("RunChain", fields: [parentRunId], references: [id], onDelete: SetNull)
  children     AgentRun[]      @relation("RunChain")
  triggeredBy  User?           @relation("RunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events       RunEvent[]
  toolExecutions ToolExecution[]
  approvals    Approval[]
  artifacts    Artifact[]

  @@index([intentId, createdAt])
  @@index([agentId, status])
  @@index([status])
}

/// Append-only execution timeline. This is what the Live Execution UI renders.
model RunEvent {
  id         String   @id @default(cuid())
  runId      String
  intentId   String?
  type       String // INTENT | CONTEXT | PLAN | AGENT | TOOL | APPROVAL | VALIDATION | RESULT | MEMORY | ERROR | CANCEL
  label      String
  detail     String?
  status     String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | WAITING
  nodeId     String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([intentId, createdAt])
}

model Tool {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String
  category        String // WEB | DOCUMENTS | KNOWLEDGE | PROJECTS | TASKS | FILES | CALENDAR | EMAIL | GITHUB | DATA_ANALYSIS | ARTIFACT_GENERATION
  schema          String   @default("{}") // JSON Schema for arguments
  permissionLevel String   @default("READ") // READ | WRITE | EXTERNAL_ACTION | HIGH_IMPACT
  requiresAuth    String? // integration key
  timeoutMs       Int      @default(30000)
  maxRetries      Int      @default(2)
  enabled         Boolean  @default(true)
  isBuiltin       Boolean  @default(true)
  totalCalls      Int      @default(0)
  failedCalls     Int      @default(0)
  totalLatencyMs  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions ToolExecution[]

  @@index([category])
}

model ToolExecution {
  id           String    @id @default(cuid())
  runId        String?
  toolId       String?
  toolKey      String
  arguments    String    @default("{}")
  result       String?
  status       String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | BLOCKED | VALIDATION_FAILED
  permission   String    @default("READ")
  error        String?
  attempt      Int       @default(1)
  durationMs   Int?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  run     AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  tool    Tool?     @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([toolKey])
  @@index([status])
}

model Approval {
  id             String    @id @default(cuid())
  workspaceId    String?
  intentId       String?
  runId          String?
  projectId      String?
  requestedById  String?
  title          String
  description    String
  whatWillHappen String
  whyNeeded      String
  toolKey        String?
  toolArguments  String    @default("{}")
  affectedData   String    @default("[]")
  permission     String    @default("WRITE") // WRITE | EXTERNAL_ACTION | HIGH_IMPACT
  riskLevel      String    @default("MEDIUM")
  status         String    @default("PENDING") // PENDING | APPROVED | DENIED | MODIFIED | EXPIRED | CANCELLED
  decidedById    String?
  decisionNote   String?
  decidedAt      DateTime?
  result         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  intent      Intent?     @relation(fields: [intentId], references: [id], onDelete: SetNull)
  run         AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy User?       @relation("ApprovalDecider", fields: [requestedById], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@index([status, createdAt])
  @@index([intentId])
}

// ── Artifacts ────────────────────────────────────────────────────────────────

model Artifact {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String
  projectId   String?
  intentId    String?
  runId       String?
  type        String // DOCUMENT | REPORT | RESEARCH_SUMMARY | PLAN | PRESENTATION | TABLE | ANALYSIS
  title       String
  content     String   @default("") // markdown / JSON payload
  format      String   @default("markdown")
  source      String   @default("AGENT")
  createdBy   String   @default("NEXUS")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  intent  Intent?  @relation(fields: [intentId], references: [id], onDelete: SetNull)
  run     AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([type])
}

// ── Workflows ────────────────────────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String
  projectId   String?
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ARCHIVED
  graph       String   @default("{\"nodes\":[],\"edges\":[]}")
  trigger     String   @default("MANUAL") // MANUAL | PROJECT_CREATED | DOCUMENT_UPLOADED | SCHEDULE | TASK_OVERDUE
  triggerConfig String @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  runs      WorkflowRun[]

  @@index([userId, status])
  @@index([projectId])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  intentId    String?
  status      String    @default("QUEUED") // QUEUED | RUNNING | WAITING_APPROVAL | COMPLETED | FAILED | CANCELLED
  input       String    @default("{}")
  output      String    @default("{}")
  currentNode String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  intent   Intent?  @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@index([workflowId, createdAt])
}

// ── Observability ────────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  projectId   String?
  intentId    String?
  approvalId  String?
  type        String // AGENT | TOOL | PROJECT | DOCUMENT | WORKFLOW | APPROVAL | MEMORY | INTEGRATION | ERROR | TASK | SYSTEM
  action      String
  summary     String
  entityType  String?
  entityId    String?
  severity    String   @default("INFO") // INFO | SUCCESS | WARNING | ERROR
  status      String   @default("SUCCESS")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  intent    Intent?    @relation(fields: [intentId], references: [id], onDelete: SetNull)
  approval  Approval?  @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
  @@index([severity])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  projectId   String?
  type        String // APPROVAL_REQUIRED | WORKFLOW_COMPLETED | AGENT_COMPLETED | AGENT_FAILED | DEADLINE | PROJECT_RISK | INTEGRATION_ERROR | MEMORY
  title       String
  body        String?
  severity    String    @default("INFO")
  read        Boolean   @default(false)
  actionUrl   String?
  metadata    String    @default("{}")
  createdAt   DateTime  @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

// ── Integrations & settings ──────────────────────────────────────────────────

model Integration {
  id             String    @id @default(cuid())
  userId         String
  key            String // github | google_drive | google_calendar | gmail | slack | notion
  name           String
  description    String?
  status         String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR | EXPIRED
  accountLabel   String?
  scopes         String    @default("[]")
  availableTools String    @default("[]")
  // Encrypted-at-rest credential blob. Never leaves the server.
  credentials    String?
  lastSyncedAt   DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String
  namespace String // ai | agents | memory | permissions | notifications | appearance | security | profile
  key       String
  value     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, namespace, key])
  @@index([userId, namespace])
}

/// Background job abstraction — survives process restarts and long-running agents.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     String    @default("{}")
  status      String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lastError   String?
  result      String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([type])
}

/// Security audit trail. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

