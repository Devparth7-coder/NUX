// NEXUS — Data Model
// PostgreSQL 17 + pgvector. Domain-rich, retrieval-optimised, fully relational.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Dimension of the local deterministic embedding provider.
/// OpenAI text-embedding-3-small is 1536; the local provider projects into the
/// same space via hashing, so the column size is fixed at 512 for both.
/// (see src/lib/retrieval/embeddings.ts)

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectHealth {
  HEALTHY
  AT_RISK
  BLOCKED
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  USER
  AGENT
  WORKFLOW
  INTEGRATION
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXED
  FAILED
}

enum KnowledgeKind {
  FACT
  DECISION
  CONCEPT
  PERSON
  ORGANIZATION
  TECHNOLOGY
  RISK
  INSIGHT
}

enum MemoryType {
  SHORT_TERM
  PROJECT
  LONG_TERM
  EXPLICIT
}

enum MemoryScope {
  SESSION
  PROJECT
  USER
  WORKSPACE
}

enum IntentStatus {
  RECEIVED
  UNDERSTOOD
  PLANNING
  EXECUTING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PermissionLevel {
  READ
  WRITE
  EXTERNAL_ACTION
  HIGH_IMPACT
}

enum AgentStatus {
  ACTIVE
  IDLE
  DISABLED
}

enum RunStatus {
  QUEUED
  PLANNING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL
}

enum ToolStatus {
  AVAILABLE
  UNAVAILABLE
  UNAUTHENTICATED
}

enum ToolExecutionStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  DENIED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  MODIFIED
  EXPIRED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum ArtifactType {
  REPORT
  RESEARCH_SUMMARY
  TASK_PLAN
  PRESENTATION
  TABLE
  ANALYSIS
  DOCUMENT
  BRIEF
}

enum ActivityKind {
  AGENT
  TOOL
  PROJECT
  DOCUMENT
  TASK
  WORKFLOW
  APPROVAL
  MEMORY
  INTEGRATION
  ERROR
  SYSTEM
}

enum NotificationKind {
  APPROVAL_REQUIRED
  RUN_COMPLETED
  RUN_FAILED
  DEADLINE_APPROACHING
  PROJECT_AT_RISK
  INTEGRATION_ERROR
  MEMORY_SAVED
  WORKFLOW_COMPLETED
}

enum IntegrationKind {
  GITHUB
  GOOGLE_DRIVE
  GOOGLE_CALENDAR
  GMAIL
  SLACK
  NOTION
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  NOT_CONFIGURED
}

enum RunEventKind {
  INTENT_RECEIVED
  INTENT_UNDERSTOOD
  CONTEXT_RETRIEVED
  PLAN_CREATED
  AGENT_SELECTED
  AGENT_STARTED
  AGENT_PROGRESS
  AGENT_COMPLETED
  AGENT_FAILED
  TOOL_SELECTED
  TOOL_STARTED
  TOOL_COMPLETED
  TOOL_FAILED
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  APPROVAL_DENIED
  VALIDATION_STARTED
  VALIDATION_COMPLETED
  MEMORY_UPDATED
  ARTIFACT_CREATED
  RESULT_READY
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY & WORKSPACE
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  projects        Project[]           @relation("ProjectOwner")
  ownedTasks      Task[]              @relation("TaskAssignee")
  documents       Document[]
  memories        Memory[]
  conversations   Conversation[]
  messages        Message[]
  intents         Intent[]
  agentRuns       AgentRun[]
  approvals       Approval[]          @relation("ApprovalDecidedBy")
  workflows       Workflow[]
  artifacts       Artifact[]
  activities      Activity[]
  notifications   Notification[]
  integrations    Integration[]
  auditLogs       AuditLog[]
  preferences     UserPreference?
  notificationSet NotificationPrefs?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  documents   Document[]
  tasks       Task[]
  memories    Memory[]
  activities  Activity[]
  agents      Agent[]
  tools       Tool[]
  workflows   Workflow[]
  integrations Integration[]
  knowledge   KnowledgeItem[]
  intents     Intent[]
  agentRuns   AgentRun[]
  toolExecutions ToolExecution[]
  approvals   Approval[]
  artifacts   Artifact[]
  notifications Notification[]
  auditLogs   AuditLog[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id            String         @id @default(cuid())
  workspaceId   String
  ownerId       String
  name          String
  slug          String
  description   String?
  objective     String?
  status        ProjectStatus  @default(ACTIVE)
  health        ProjectHealth  @default(HEALTHY)
  healthReason  String?
  progress      Int            @default(0)
  color         String         @default("#3B82F6")
  targetDate    DateTime?
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  tasks     Task[]
  documents Document[]
  memories  Memory[]
  knowledge KnowledgeItem[]
  milestones Milestone[]
  intents   Intent[]
  agentRuns AgentRun[]
  artifacts Artifact[]
  activities Activity[]
  conversations Conversation[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([health])
  @@index([targetDate])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

// ─────────────────────────────────────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  workspaceId  String
  projectId    String?
  assigneeId   String?
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  completedAt  DateTime?
  source       TaskSource   @default(USER)
  createdByAgent String?
  createdByRunId String?
  blockedReason String?
  order        Int          @default(0)
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("TaskDependsOn")
  dependents   TaskDependency[] @relation("TaskDependent")
  knowledge   KnowledgeItem[]

  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([dueDate])
  @@index([assigneeId])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependent", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTS & CHUNKS
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id           String         @id @default(cuid())
  workspaceId  String
  projectId    String?
  uploaderId   String?
  title        String
  filename     String
  mimeType     String
  size         Int
  storageKey   String
  status       DocumentStatus @default(UPLOADED)
  error        String?
  pageCount    Int?
  wordCount    Int?
  chunkCount   Int            @default(0)
  summary      String?
  metadata     Json           @default("{}")
  ingestedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader  User?           @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  chunks    DocumentChunk[]
  knowledge KnowledgeItem[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([createdAt])
}

model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  content    String
  page       Int?
  section    String?
  position   Int
  tokenCount Int    @default(0)
  metadata   Json   @default("{}")

  /// pgvector column. Written & queried through raw SQL (see retrieval/hybrid.ts).
  embedding Unsupported("vector(512)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// KNOWLEDGE GRAPH
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeItem {
  id          String        @id @default(cuid())
  workspaceId String
  projectId   String?
  documentId  String?
  taskId      String?
  kind        KnowledgeKind @default(FACT)
  label       String
  content     String
  confidence  Float         @default(0.8)
  source      String        @default("seed")
  salience    Float         @default(0.5)
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// pgvector column (raw SQL write/query).
  embedding Unsupported("vector(512)")?

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  document    Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  outgoing    KnowledgeRelation[] @relation("RelationSource")
  incoming    KnowledgeRelation[] @relation("RelationTarget")

  @@index([workspaceId, kind])
  @@index([projectId])
  @@index([label])
}

model KnowledgeRelation {
  id         String   @id @default(cuid())
  sourceId   String
  targetId   String
  type       String
  weight     Float    @default(1)
  evidence   String?
  derivedFrom String  @default("system")
  createdAt  DateTime @default(now())

  source KnowledgeItem @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target KnowledgeItem @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEMORY
// ─────────────────────────────────────────────────────────────────────────────

model Memory {
  id             String      @id @default(cuid())
  workspaceId    String
  userId         String?
  projectId      String?
  conversationId String?
  type           MemoryType  @default(LONG_TERM)
  scope          MemoryScope @default(USER)
  content        String
  summary        String?
  source         String      @default("system")
  confidence     Float       @default(0.8)
  importance     Float       @default(0.5)
  accessCount    Int         @default(0)
  enabled        Boolean     @default(true)
  pinned         Boolean     @default(false)
  tags           String[]    @default([])
  metadata       Json        @default("{}")
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  /// pgvector column (raw SQL write/query).
  embedding Unsupported("vector(512)")?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
  @@index([workspaceId, enabled])
  @@index([projectId])
  @@index([userId])
  @@index([importance])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONVERSATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  summary     String?
  archived    Boolean  @default(false)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages Message[]
  intents Intent[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  userId         String?
  role           String   // user | nexus | system
  kind           String   @default("message") // message | intent | plan | result | approval | error
  content        String
  structured     Json?
  intentId       String?
  runId          String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTENT
// ─────────────────────────────────────────────────────────────────────────────

model Intent {
  id              String       @id @default(cuid())
  workspaceId     String
  userId          String
  conversationId  String?
  rawInput        String
  objective       String
  desiredOutcome  String
  entities        Json         @default("[]")
  constraints     Json         @default("[]")
  deadlineText    String?
  deadline        DateTime?
  projectId       String?
  capabilities    String[]     @default([])
  riskLevel       RiskLevel    @default(LOW)
  permissions     String[]     @default([])
  status          IntentStatus @default(RECEIVED)
  confidence      Float        @default(0)
  understoodAt    DateTime?
  completedAt     DateTime?
  error           String?
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  runs         AgentRun[]
  artifacts    Artifact[]
  activities   Activity[]

  @@index([workspaceId, status])
  @@index([userId, createdAt])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AGENTS & RUNS
// ─────────────────────────────────────────────────────────────────────────────

model Agent {
  id             String      @id @default(cuid())
  workspaceId    String
  key            String      // planning | research | knowledge | execution | review | creative | analyst
  name           String
  description    String
  systemPrompt   String
  capabilities   String[]    @default([])
  allowedTools   String[]    @default([])
  permissionLevel PermissionLevel @default(READ)
  model          String      @default("nexus-default")
  temperature    Float       @default(0.2)
  maxTokens      Int         @default(2048)
  status         AgentStatus @default(ACTIVE)
  totalRuns      Int         @default(0)
  successRuns    Int         @default(0)
  totalLatencyMs Int         @default(0)
  totalTokens    Int         @default(0)
  totalCostUsd   Float       @default(0)
  lastRunAt      DateTime?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AgentRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model AgentRun {
  id             String    @id @default(cuid())
  workspaceId    String
  intentId       String?
  agentId        String?
  parentRunId    String?
  userId         String
  projectId      String?
  key            String    // agent key or "orchestrator"
  name           String
  status         RunStatus @default(QUEUED)
  step           String?
  input          Json      @default("{}")
  context        Json      @default("{}")
  outputs        Json      @default("{}")
  error          String?
  errorDetail    Json?
  progress       Int       @default(0)
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  costUsd        Float     @default(0)
  latencyMs      Int?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  intent    Intent?          @relation(fields: [intentId], references: [id], onDelete: SetNull)
  agent     Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    AgentRun?        @relation("RunTree", fields: [parentRunId], references: [id], onDelete: Cascade)
  children  AgentRun[]       @relation("RunTree")
  toolExecutions ToolExecution[]
  events    RunEvent[]
  approvals Approval[]
  artifacts Artifact[]
  modelCalls ModelCall[]

  @@index([workspaceId, status])
  @@index([intentId])
  @@index([status, createdAt])
  @@index([projectId])
}

model RunEvent {
  id        String       @id @default(cuid())
  runId     String?
  intentId  String?
  kind      RunEventKind
  message   String
  detail    Json         @default("{}")
  actor     String       @default("system")
  at        DateTime     @default(now())

  run AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@index([intentId, at])
}

model ModelCall {
  id          String   @id @default(cuid())
  workspaceId String
  runId       String?
  provider    String
  model       String
  purpose     String
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Float    @default(0)
  latencyMs   Int      @default(0)
  status      String   @default("ok") // ok | error | fallback
  error       String?
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  run AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([runId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TOOLS
// ─────────────────────────────────────────────────────────────────────────────

model Tool {
  id             String     @id @default(cuid())
  workspaceId    String
  key            String     // tasks.create
  name           String
  description    String
  category       String
  permissionLevel PermissionLevel @default(READ)
  requiresAuth   String?
  timeoutMs      Int        @default(30000)
  retryPolicy    Json       @default("{\"maxAttempts\":2,\"backoffMs\":500}")
  schema         Json       @default("{}")
  status         ToolStatus @default(AVAILABLE)
  enabled        Boolean    @default(true)
  totalCalls     Int        @default(0)
  failedCalls    Int        @default(0)
  totalLatencyMs Int        @default(0)
  lastCalledAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions ToolExecution[]

  @@unique([workspaceId, key])
  @@index([workspaceId, category])
}

model ToolExecution {
  id             String              @id @default(cuid())
  workspaceId    String
  runId          String?
  toolId         String?
  toolKey        String
  status         ToolExecutionStatus @default(PENDING)
  input          Json                @default("{}")
  output         Json?
  error          String?
  permissionLevel PermissionLevel    @default(READ)
  requiresApproval Boolean           @default(false)
  durationMs     Int?
  attempt        Int                 @default(1)
  simulated      Boolean             @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  tool      Tool?     @relation(fields: [toolId], references: [id], onDelete: SetNull)
  approvals Approval[]

  @@index([workspaceId, createdAt])
  @@index([runId])
  @@index([toolKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// APPROVALS
// ─────────────────────────────────────────────────────────────────────────────

model Approval {
  id             String         @id @default(cuid())
  workspaceId    String
  runId          String?
  toolExecutionId String?
  toolKey        String
  title          String
  whatHappens    String
  whyNeeded      String
  affectedData   Json           @default("{}")
  permissionLevel PermissionLevel
  status         ApprovalStatus @default(PENDING)
  requestedBy    String         @default("agent")
  decidedById    String?
  decisionNote   String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  payload        Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run           AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  toolExecution ToolExecution? @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([runId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKFLOWS
// ─────────────────────────────────────────────────────────────────────────────

model Workflow {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  version     Int            @default(1)
  definition  Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes     WorkflowNode[]
  edges     WorkflowEdge[]
  runs      WorkflowRun[]

  @@index([workspaceId, status])
}

model WorkflowNode {
  id         String @id @default(cuid())
  workflowId String
  key        String
  type       String // TRIGGER | AGENT | TOOL | CONDITION | APPROVAL | DELAY | BRANCH | LOOP | OUTPUT
  label      String
  config     Json   @default("{}")
  positionX  Float  @default(0)
  positionY  Float  @default(0)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model WorkflowEdge {
  id         String  @id @default(cuid())
  workflowId String
  sourceId   String
  targetId   String
  label      String?
  condition  String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model WorkflowRun {
  id          String            @id @default(cuid())
  workflowId  String
  workspaceId String
  userId      String
  status      WorkflowRunStatus @default(QUEUED)
  version     Int               @default(1)
  input       Json              @default("{}")
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([workspaceId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ARTIFACTS, ACTIVITY, NOTIFICATIONS, INTEGRATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Artifact {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String?
  intentId    String?
  runId       String?
  createdById String?
  type        ArtifactType @default(DOCUMENT)
  title       String
  summary     String?
  content     String
  structured  Json         @default("{}")
  format      String       @default("markdown")
  bytes       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  intent    Intent?   @relation(fields: [intentId], references: [id], onDelete: SetNull)
  run       AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
  @@index([projectId])
  @@index([intentId])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String?
  projectId   String?
  intentId    String?
  kind        ActivityKind @default(SYSTEM)
  action      String
  summary     String
  detail      Json         @default("{}")
  entityType  String?
  entityId    String?
  status      String       @default("info") // info | success | warning | error
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  intent    Intent?   @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind])
  @@index([projectId])
  @@index([intentId])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  kind        NotificationKind
  title       String
  body        String
  href        String?
  read        Boolean          @default(false)
  archived    Boolean          @default(false)
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Integration {
  id             String            @id @default(cuid())
  workspaceId    String
  userId         String
  kind           IntegrationKind
  status         IntegrationStatus @default(NOT_CONFIGURED)
  accountLabel   String?
  scopes         String[]          @default([])
  toolsAvailable String[]          @default([])
  /// Encrypted credential blob. Never serialised to the client.
  credentials    String?
  lastSyncedAt   DateTime?
  lastError      String?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  detail      Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  theme       String   @default("dark")
  density     String   @default("comfortable")
  reducedMotion Boolean @default(false)
  autoApproveRead Boolean @default(true)
  defaultProjectId String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPrefs {
  id                 String @id @default(cuid())
  userId             String @unique
  approvalRequired   Boolean @default(true)
  runCompleted       Boolean @default(true)
  runFailed          Boolean @default(true)
  deadlineApproaching Boolean @default(true)
  projectAtRisk      Boolean @default(true)
  integrationError   Boolean @default(true)
  emailDigest        Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
